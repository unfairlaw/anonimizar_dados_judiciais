# LLM Provider Configuration
# Options: bedrock, openai, anthropic, ollama
LLM_PROVIDER=bedrock
LLM_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# AWS Bedrock Configuration (recommended for AWS deployments)
BEDROCK_REGION=us-east-1
BEDROCK_LLM_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v1

# Available Bedrock Models:
# LLM Models:
#   - anthropic.claude-3-sonnet-20240229-v1:0 (recommended, balanced)
#   - anthropic.claude-3-haiku-20240307-v1:0 (fast, cheaper)
#   - anthropic.claude-3-opus-20240229-v1:0 (most capable, expensive)
#   - amazon.titan-text-express-v1
#   - meta.llama3-70b-instruct-v1:0
#   - cohere.command-r-plus-v1:0
# Embedding Models:
#   - amazon.titan-embed-text-v1 (1536 dimensions)
#   - cohere.embed-english-v3 (1024 dimensions)
#   - cohere.embed-multilingual-v3 (1024 dimensions)

# API Keys (only needed if using OpenAI/Anthropic providers)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding Configuration
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v1
EMBEDDING_DIMENSION=1536

# Vector Store Configuration
# Options: chroma, faiss
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/vector_store
COLLECTION_NAME=rag_documents

# Retrieval Configuration
# Options: vector, keyword, hybrid
RETRIEVAL_METHOD=hybrid
RETRIEVAL_TOP_K=5
HYBRID_ALPHA=0.5

# Reranking Configuration
RERANKING_ENABLED=true
RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKING_TOP_K=3

# Query Transformation
QUERY_REWRITING_ENABLED=true
MAX_QUERY_REWRITES=2

# Routing Configuration
ROUTING_ENABLED=true
ENABLE_WEB_SEARCH=false

# Self-Correction Configuration
SELF_CORRECTION_ENABLED=true
MAX_CORRECTION_ITERATIONS=3
RELEVANCE_THRESHOLD=0.7

# Evaluation Configuration
EVALUATION_METRICS=context_relevancy,answer_relevancy,faithfulness,context_recall

# AWS S3 Configuration (for AWS deployments)
S3_BUCKET_NAME=your-rag-bucket
S3_VECTOR_STORE_PREFIX=vector_store
S3_DOCUMENTS_PREFIX=documents

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=./logs/rag_ecosystem.log
